# Copy to .env for local development. Everything is optional: with no keys at all the app still
# answers, by quoting the most relevant sentences (extractive fallback).

# --- Who writes the answers: the visitor chooses on the page ---
# Anthropic / OpenAI: the visitor's own key (sent per request, never stored). Model suggestions:
# ANTHROPIC_MODELS=claude-haiku-4-5-20251001,claude-sonnet-5-5,claude-opus-5-5
# OPENAI_MODELS=gpt-4o-mini,gpt-4.1-mini,gpt-4.1,gpt-4o
# Gemini: the site's free keys (https://aistudio.google.com/apikey), comma-separated. Used ONLY when a
# visitor selects Gemini; a key that hits its quota is skipped for a minute and the next one is used.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# Nothing chosen / no key / model error -> the answer is quoted from the documents (no LLM).

# --- Vector store: empty = in-memory (default). docker-compose sets a Qdrant server URL. ---
QDRANT_URL=

# --- Langfuse tracing (optional, free cloud account at https://cloud.langfuse.com) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Public demo protection (defaults shown) ---
# ASKS_PER_MINUTE=12        per visitor IP
# UPLOADS_PER_HOUR=20
# CACHE_MINUTES=360         repeated questions about the samples are answered from memory
# SESSION_TTL_MINUTES=30    a visitor's private document set resets after this much idle time
# MAX_SESSIONS=50
# MAX_UPLOADS=5             files per visitor
# MAX_UPLOAD_BYTES=2000000

# --- Retrieval tuning (defaults shown) ---
# TOP_K=4
# CANDIDATES=20
# MIN_RERANK_SCORE=-3.0
# GROUNDING_SIMILARITY=0.78
# MIN_GROUNDEDNESS=0.7
