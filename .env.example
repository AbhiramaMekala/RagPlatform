# Copy to .env for local development. Everything is optional: with no keys at all the app still
# answers, by quoting the most relevant sentences (extractive fallback).

# --- Who writes the answers, tried in this order for every question ---
# 1. a visitor's own OpenAI key, typed into the demo page (sent per request, never stored)
# 2. free Gemini keys (https://aistudio.google.com/apikey), comma-separated; a key that hits its
#    quota is skipped for a minute and the next one is used
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# 3. your own OpenAI key. Leave EMPTY on a public demo so visitors never cost you money.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# 4. extractive fallback (no LLM)

# --- Vector store: empty = in-memory (default). docker-compose sets a Qdrant server URL. ---
QDRANT_URL=

# --- Langfuse tracing (optional, free cloud account at https://cloud.langfuse.com) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Public demo protection (defaults shown) ---
# ASKS_PER_MINUTE=12        per visitor IP
# UPLOADS_PER_HOUR=20
# CACHE_MINUTES=360         repeated questions about the samples are answered from memory
# SESSION_TTL_MINUTES=30    a visitor's private document set resets after this much idle time
# MAX_SESSIONS=50
# MAX_UPLOADS=5             files per visitor
# MAX_UPLOAD_BYTES=2000000

# --- Retrieval tuning (defaults shown) ---
# TOP_K=4
# CANDIDATES=20
# MIN_RERANK_SCORE=-3.0
# GROUNDING_SIMILARITY=0.78
# MIN_GROUNDEDNESS=0.7
