# Copy to .env and fill in what you have. Everything is optional.

# LLM answers. Order per question: the visitor's own OpenAI key (entered in the demo UI, never stored)
# -> free Gemini keys below -> OPENAI_API_KEY (if set) -> extractive (no-LLM) fallback.
# On a public demo, leave OPENAI_API_KEY empty so you never pay for visitors' questions.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Free backup LLM: one or more Gemini API keys (https://aistudio.google.com/apikey), comma-separated.
# Requests rotate across the keys; a key that hits its quota is skipped for a minute.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# Visitor sandbox: each visitor can view, remove and upload documents in a private copy that resets.
# SESSION_TTL_MINUTES=30
# MAX_SESSIONS=50
# MAX_UPLOADS=5
# MAX_UPLOAD_BYTES=2000000
# MAX_DOC_CHARS=60000

# Langfuse tracing (free cloud account at https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith tracing of the LangChain LLM call (alternative/extra to Langfuse)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Qdrant: leave empty for embedded local mode. docker-compose sets this for you.
QDRANT_URL=

# Tuning knobs (defaults shown)
# TOP_K=4
# CANDIDATES=20
# MIN_RERANK_SCORE=-3.0
# GROUNDING_SIMILARITY=0.78
# MIN_GROUNDEDNESS=0.7
